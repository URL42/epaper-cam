/*
 * Copy this file to secrets.h and fill it in. secrets.h is gitignored and must
 * stay that way — this repository is public.
 *
 * The sketch compiles fine without secrets.h; upload is simply disabled and a
 * hold reports as much. That keeps the repo buildable by anyone who clones it
 * without asking them to invent credentials first.
 */

#pragma once

#define WIFI_SSID       "your-network"
#define WIFI_PASS       "your-password"

/*
 * Where the photo goes. An n8n webhook is the intended target: it holds the
 * Google Drive credential so the camera never has to. OAuth2 token refresh on
 * a microcontroller is genuinely unpleasant — expiry, refresh flows, clock
 * skew, certificate storage — and n8n already solves all of it.
 *
 * Plain http:// to something on your own LAN avoids TLS on the ESP32
 * altogether. Use https:// only if the endpoint is off your network, and
 * expect the handshake to add a second or two.
 *
 * For a first test, point this at tools/recv_upload.py running on your Mac.
 * The photo then never leaves your network.
 */
#define UPLOAD_URL      "http://192.168.1.50:8080/papercam"

/*
 * Optional. Sent as the X-PaperCam-Token header, so an n8n webhook can reject
 * anything that is not the camera. Leave empty to omit the header.
 */
#define UPLOAD_TOKEN    ""
